{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bizzle",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build-static.js" },
  "d1_databases": [{ "binding": "DB", "database_name": "bizzle", "database_id": "4388f67d-4f18-4c08-b0dc-08b143c79baf", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "WORKSPACES", "class_name": "ClientWorkspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientWorkspace"] }],
  "routes": [{ "pattern": "biz.ackerworks.com", "custom_domain": true }],
  "vars": { "ALPHA_MODE": "true" },
  "observability": { "enabled": true }
}
